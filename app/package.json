{
  "name": "focus-timer-app",
  "version": "1.0.0",
  "description": "Focus Timer Desktop App",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "dist": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= electron-builder --win",
    "dist:debug": "electron-vite build && cross-env ELECTRON_ENABLE_LOGGING=1 CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= electron-builder --win",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.6.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.60.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.focustimer.app",
    "productName": "Focus Timer",
    "copyright": "Copyright © 2026 Focus Timer",
    "icon": "../icon.ico",
    "directories": {
      "output": "C:\\Users\\timo0\\AppData\\Local\\Temp\\ft-dist"
    },
    "files": [
      "out/**/*",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "sidecar/",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Focus Timer",
      "installerIcon": "../icon.ico",
      "uninstallerIcon": "../icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "FocusTimer-portable.exe"
    }
  }
}
